<Window x:Class="WpfAppServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPC UA Server Demo" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="启动服务器" Width="150" Height="40" Margin="10"
                    Click="StartServerButton_Click"/>
            <Button Content="停止服务器" Width="150" Height="40" Margin="10"
                    Click="StopServerButton_Click"/>
        </StackPanel>
    </Grid>
</Window>